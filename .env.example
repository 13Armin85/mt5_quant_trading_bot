# Desktop app: open Start.cmd and enter account details in the browser.
# These optional MT5 fields are for legacy direct Python execution only.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Defaults work without keys: Forex Factory weekly export + official Fed/ECB RSS.
# These optional URLs override the default public calendar/headline adapters.
NEWS_API_KEY=
ECONOMIC_API_KEY=
NEWS_API_URL=
ECONOMIC_API_URL=
DATABASE_URL=sqlite:///trading_bot.db
ENABLE_LIVE_TRADING=false
# Start.cmd prepares the local authenticated account portal and MT5 bridge.
# Leave MT5_BRIDGE_URL unset for direct Windows execution.
# MT5_BRIDGE_URL=http://host.docker.internal:18765
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
